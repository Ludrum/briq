# Briq controller configuration and secrets.
#
# Install to /etc/briq-control/controller.env, mode 0600 root:root.
# systemd reads it as root and passes it to the service in the environment,
# so the unprivileged `briq` user never gets to read the file itself.
#
#   sudo install -d -m 700 /etc/briq-control
#   sudo install -m 600 controller.env.example /etc/briq-control/controller.env
#   sudo nano /etc/briq-control/controller.env
#
# NEVER commit the real file. It is gitignored, and it is the one thing in
# this project that genuinely is a password.

# The master token. It authorises every loosening: lifting a profile,
# removing a schedule that has already run. It is printed into the QR sheet
# and written onto NFC tags, so treat both as credentials.
#
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRIQ_TOKEN=replace-me-with-a-generated-token

# Port the controller listens on. nftables and the Android app both assume
# 8088; change all three together or none.
BRIQ_PORT=8088

# Comma-separated networks whose requests the controller will answer at all.
# This is a backstop behind nftables, not the primary control.
#
# Start with your LAN subnet. Add 100.64.0.0/10,fd7a:115c:a1e0::/48 only if
# you follow docs/TAILSCALE.md.
BRIQ_TRUSTED_NETS=192.168.1.0/24,127.0.0.1/32,::1/128

# host[:port] baked into the QR codes and NFC tag URLs by gen-qr.py.
# Use the Pi's reserved IP address, not a hostname: the `offline` profile
# denies DNS, and a hostname would stop resolving exactly when you need the
# way out to work.
BRIQ_HOST_FOR_QR=192.168.1.2:8088

# AdGuard Home admin API. The controller rewrites filter rules through it.
AGH_URL=http://127.0.0.1:3000
AGH_USER=admin
AGH_PASS=replace-me-with-your-adguard-admin-password
