# Normalise to LF in the repository.
* text=auto

# These run on the Pi. A CRLF line ending in a shebang script is a
# "bad interpreter" error, so pin them regardless of the checkout platform.
*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.list          text eol=lf
pi/briqctl     text eol=lf
pi/nftables.conf.example    text eol=lf
pi/controller.env.example   text eol=lf
pi/logrotate.briq-control  text eol=lf
*.service       text eol=lf
gradlew         text eol=lf

gradlew.bat     text eol=crlf

*.ttf   binary
*.stl   binary
*.jar   binary
*.png   binary
*.jpg   binary
